# FILE: .env.production
ENVIRONMENT=production
PORT=8080

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=golang_api_prod

JWT_SECRET=production-secret-key-very-long-and-random
JWT_EXPIRATION_HOURS=24
REFRESH_EXPIRATION_DAYS=7

LOG_PATH=./logs

CORS_ALLOWED_ORIGINS=https://app.example.com,https://api.example.com